# Root Environment Configuration for Resumate Monorepo

# Development URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# Database Configuration
DATABASE_URL=./data/resumate.db

# Google AI Configuration (users will provide their own API keys via frontend)
# GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Security
JWT_SECRET=your_jwt_secret_here_for_future_auth

# CORS
CORS_ORIGIN=http://localhost:3000

# Production Configuration (uncomment for production)
# NODE_ENV=production
# PORT=3001
# DATABASE_URL=postgresql://user:password@localhost:5432/resumate