# Root Environment Configuration for Resumate Monorepo

# Development URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# Database Configuration
DATABASE_URL=./data/resumate.db

# Google AI Configuration (users will provide their own API keys via frontend)
# GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Security
JWT_SECRET=your_jwt_secret_here_for_future_auth

# GitHub integration (M2) — register a GitHub App (user-to-server OAuth).
# Callback URL must be <BACKEND_URL>/api/github/callback
# GITHUB_CLIENT_ID=your_github_app_client_id
# GITHUB_CLIENT_SECRET=your_github_app_client_secret
# GITHUB_REDIRECT_URI=http://localhost:4300/api/github/callback
# 32-byte hex key for AES-256-GCM encryption of stored OAuth tokens
# (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# GITHUB_TOKEN_ENCRYPTION_KEY=64_hex_chars
# Set to 'false' to stop injecting GitHub evidence into tailoring prompts
# GITHUB_TAILOR_EVIDENCE=true
# App slug from the GitHub App URL (github.com/apps/<slug>) — powers the
# "grant repo access" install link shown when a user opts into private repos
# GITHUB_APP_SLUG=your_github_app_slug

# CORS
CORS_ORIGIN=http://localhost:3000

# Production Configuration (uncomment for production)
# NODE_ENV=production
# PORT=3001
# DATABASE_URL=postgresql://user:password@localhost:5432/resumate