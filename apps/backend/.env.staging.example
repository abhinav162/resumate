# Backend Staging Environment Variables
# Copy this file to .env.staging for staging deployment
# IMPORTANT: Use different secrets than production!

PORT=4310
NODE_ENV=staging
FRONTEND_URL=https://resumate.gftrilo.store
DB_PATH=../../data/resumate.db

# CORS Configuration
CORS_ORIGIN=https://resumate.gftrilo.store

# Security - IMPORTANT: Generate unique secrets for staging!
# Use: openssl rand -base64 32
JWT_SECRET=your_staging_jwt_secret_minimum_32_characters_different_from_prod
SESSION_SECRET=your_staging_session_secret_minimum_32_characters_different_from_prod

# Google OAuth Configuration for Staging
# Get these from Google Cloud Console (can be same as production or separate staging credentials)
GOOGLE_CLIENT_ID=your_staging_google_client_id_here
GOOGLE_CLIENT_SECRET=your_staging_google_client_secret_here
GOOGLE_CALLBACK_URL=https://resumate.gftrilo.store/api/auth/google/callback

# IMPORTANT: Add this callback URL to Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: https://resumate.gftrilo.store/api/auth/google/callback
