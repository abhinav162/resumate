# Backend Environment Variables
# Copy this file to .env.production for production deployment
# IMPORTANT: Change JWT_SECRET to a secure random string in production!

PORT=4300
NODE_ENV=production
FRONTEND_URL=http://localhost:3160
DB_PATH=../../data/resumate.db

CORS_ORIGIN=http://localhost:3160

# Security
JWT_SECRET=your_jwt_secret_here_minimum_32_characters
SESSION_SECRET=your_session_secret_here_minimum_32_characters

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:4300/api/auth/google/callback