# Frontend Staging Environment Variables
# Copy this file to .env.staging for staging deployment

# API URL - Points to staging backend through nginx
# Nginx should route /api/* to backend at localhost:4310
VITE_API_URL=https://resumate.gftrilo.store/api

# Environment
NODE_ENV=staging

# NOTE: For local staging testing without nginx:
# VITE_API_URL=http://localhost:4310/api
